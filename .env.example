# Server-side only. Never expose either provider credential to the browser.
HELIUS_API_KEY=
BITQUERY_ACCESS_TOKEN=
# demo (default) emits clearly labelled synthetic events; live enables configured adapters.
DATA_MODE=demo
PORT=8787
# Configure to your approved Binance Web3 token route. {token} and {network} are replaced.
BINANCE_TOKEN_URL_TEMPLATE=https://www.binance.com/en/web3?token={token}&network={network}
